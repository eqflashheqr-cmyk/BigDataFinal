.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Credentials — never commit these
# ---------------------------------------------------------------------------
.env
.env.*
*.pem
*.key
secrets/
credentials*.json
token*.json
.netrc

# LaTeX build artefacts
latex_report/*.aux
latex_report/*.log
latex_report/*.out
latex_report/pass*.log
latex_report/pass*.err
latex_report/*.png
!latex_report/figures/*.png

# The report is delivered as latex_report/report.pdf (ACM 2-column).
# The old ReportLab render at the repository root is superseded and
# is regenerated on demand by src/export_pdf.py.
/report.pdf

# Local scratch logs
*.log
*.err

# ---------------------------------------------------------------------------
# Intermediate artefacts
#
# These are regenerated by the scripts that produce them, so they are not
# tracked. Keeping them out of the repository keeps the clone small without
# losing anything a reviewer needs.
#
#   results/rq*_pandas.csv, results/rq*_spark.csv
#       Written by src/analysis.py. The canonical, consolidated files that
#       the report and the figures actually read are results/rq1..rq4.csv.
#   results/_equiv_pandas.json, results/_equiv_spark.json
#       Written by src/equivalence.py. The comparison result that the report
#       cites is results/equivalence_report.json.
#   latex_template/
#       The ACM template as provided, extracted from the instructor's .zip.
#       The working copy used to build the report is in latex_report/.
# ---------------------------------------------------------------------------
results/rq*_pandas.csv
results/rq*_spark.csv
results/_equiv_pandas.json
results/_equiv_spark.json
latex_template/
